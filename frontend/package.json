    "supabase:deploy:news": "npm run supabase:deploy:news-articles && npm run supabase:deploy:news-videos && npm run supabase:deploy:news-public-feed && npm run supabase:deploy:market-sparklines",
    "supabase:deploy:ipo-sync": "supabase functions deploy ipo-sync --no-verify-jwt",
    "supabase:invoke:ipo-sync": "node scripts/invoke-ipo-sync.mjs"
