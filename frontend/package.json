    "start": "craco start",
    "build": "cross-env CI=false DISABLE_ESLINT_PLUGIN=true GENERATE_SOURCEMAP=false craco build",
    "test": "craco test",
    "dev": "concurrently -k -n api,web -c blue,green \"node scripts/dev-api-server.js\" \"craco start\"",
    "dev:api": "node scripts/dev-api-server.js",
    "cf:dev": "wrangler dev",
    "cf:deploy": "npm run build && wrangler deploy",
    "deploy": "npm run cf:deploy",
    "social:instagram-stories": "node scripts/render-instagram-stories.js",
    "social:instagram-reels": "node scripts/render-instagram-reels.js",
    "social:instagram-posts-ingest": "node scripts/ingest-ig-posts-from-staging.js",
    "social:facebook-avatars": "node scripts/generate-fb-portraits-ai.mjs",
    "social:instagram-avatars": "node scripts/generate-ig-portraits-ai.mjs --force",
    "logo:transparent": "node scripts/transparentize-kapitalmitte-logo.cjs",
    "logo:png": "node scripts/svg-to-png.cjs",
    "favicons:generate": "node scripts/generate-favicons.mjs",
    "pdf:bbva:html": "node \"PDFS scripts/node/assemble-bbva-tagesgeld-html.mjs\"",
    "pdf:bbva": "node \"PDFS scripts/node/assemble-bbva-tagesgeld-html.mjs\" && node \"PDFS scripts/node/generate-bbva-tagesgeld-pdf.mjs\"",
    "pdf:bbva:flex": "node \"PDFS scripts/node/assemble-bbva-tagesgeld-html.mjs\" flexgeld && node \"PDFS scripts/node/generate-bbva-flexgeld-pdf.mjs\"",
    "pdf:vitruvian:knockout": "node \"PDFS scripts/node/process-vitruvian-logo.mjs\"",
    "pdf:qrcode:white": "node \"PDFS scripts/node/process-qrcode-white.mjs\"",
    "pdf:bbva:pi": "node \"PDFS scripts/node/generate-bbva-produktinfo-pdf.mjs\"",
    "pdf:bbva:pi:flex": "node \"PDFS scripts/node/generate-bbva-produktinfo-flexgeld-pdf.mjs\"",
    "pdf:bbva:bedingungen": "node \"PDFS scripts/node/assemble-bbva-tagesgeld-bedingungen-html.mjs\" && node \"PDFS scripts/node/generate-bbva-tagesgeld-bedingungen-pdf.mjs\"",
    "pdf:bbva:bedingungen:flex": "node \"PDFS scripts/node/assemble-bbva-flexgeld-bedingungen-html.mjs\" && node \"PDFS scripts/node/generate-bbva-flexgeld-bedingungen-pdf.mjs\"",
    "pdf:bunq:kapital": "node \"PDFS scripts/node/assemble-bunq-kapitalanlagenvertrag-html.mjs\" && node \"PDFS scripts/node/generate-bunq-kapitalanlagenvertrag-pdf.mjs\"",
    "pdf:bunq:kapital:form": "node \"PDFS scripts/node/assemble-bunq-kapitalanlagenvertrag-html.mjs\" && node \"PDFS scripts/node/generate-contract-pdf.mjs\" \"PDFS scripts/Bunq_Kapitalanlagenvertrag_Final.html\" \"PDFS/Bunq_Kapitalanlagenvertrag_Form.pdf\" \"none\"",
    "pdf:bunq:pi:flex": "node \"PDFS scripts/node/assemble-bunq-produktinfo-flexgeld-html.mjs\" && node \"PDFS scripts/node/generate-bunq-produktinfo-flexgeld-pdf.mjs\"",
    "supabase:version": "supabase --version",
    "supabase:link": "supabase link",
    "supabase:deploy:stock-prices": "supabase functions deploy stock-prices --no-verify-jwt",
    "supabase:deploy:stock-history": "supabase functions deploy stock-history --no-verify-jwt",
    "supabase:deploy:send-stock-email": "supabase functions deploy send-stock-email --no-verify-jwt",
    "supabase:deploy:send-weekly-digest": "supabase functions deploy send-weekly-digest --no-verify-jwt",
    "supabase:deploy:macro-rates": "supabase functions deploy macro-rates --no-verify-jwt",
